{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Validator Template",
  "type": "object",
  "required": ["id", "name", "columns"],
  "additionalProperties": false,
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "name": {"type": "string", "minLength": 1},
    "version": {"type": "string"},
    "description": {"type": "string"},
    "strict": {"type": "boolean", "default": false},
    "null_values": {"type": "array", "items": {"type": "string"}},
    "xml_record_path": {"type": "string"},
    "dataset_rules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type"],
        "additionalProperties": false,
        "properties": {
          "type": {"type": "string", "enum": ["unique_together"]},
          "columns": {"type": "array", "items": {"type": "string"}, "minItems": 2}
        }
      }
    },
    "columns": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "type"],
        "additionalProperties": false,
        "properties": {
          "name": {"type": "string"},
          "aliases": {"type": "array", "items": {"type": "string"}},
          "type": {
            "type": "string",
            "enum": ["text", "string", "integer", "number", "boolean", "date", "datetime", "enum"]
          },
          "required": {"type": "boolean"},
          "nullable": {"type": "boolean"},
          "rules": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "regex": {"type": "string"},
              "min_len": {"type": "integer"},
              "max_len": {"type": "integer"},
              "min": {"type": "number"},
              "max": {"type": "number"},
              "allowed": {"type": "array", "items": {"type": "string"}},
              "not_in": {"type": "array", "items": {}},
              "formats": {"type": "array", "items": {"type": "string"}},
              "unique": {"type": "boolean"},
              "min_date": {"type": "string"},
              "max_date": {"type": "string"},
              "date_format": {"type": "string"}
            }
          }
        }
      }
    }
  }
}
